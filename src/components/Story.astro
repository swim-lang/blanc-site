---
import { withBase } from "../lib/paths";
---

<section class="story" id="story">
  <div class="story__photo-wrap">
    <figure class="story__print">
      <img src={withBase("/images/owners.jpg")} alt="The owners kissing at their own wedding reception in the Blanc courtyard" loading="lazy" />
      <figcaption>Where it started — the rooms we still care for.</figcaption>
    </figure>
  </div>
  <div class="story__copy">
    <span class="eyebrow">Our Story</span>
    <h2 class="story__headline">We started here, too.</h2>
    <p class="story__lede">Before Blanc became ours to care for, it was where we got married.</p>
    <p class="story__body">
      We know the strange, wonderful feeling of walking into these rooms and imagining everyone
      you love inside them. We know how a place becomes inseparable from what happened there.
    </p>
    <p class="story__body">
      That experience still shapes how we think about Blanc. A venue should offer more than a
      beautiful backdrop. It should inspire you, support you, and hold the day without taking
      it over.
    </p>
    <p class="story__body story__body--strong">
      Now we get to help other people make the place their own. We don’t take that lightly.
    </p>
  </div>
</section>

<style>
  .story {
    display: flex;
    align-items: center;
    gap: 110px;
    padding: 130px 9.7%;
    background: var(--paper);
  }
  .story__photo-wrap {
    flex-shrink: 0;
    width: 470px;
    transform: rotate(-2.5deg);
  }
  .story__print {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 16px 16px 22px;
    background: var(--paper);
    box-shadow: 0 18px 40px rgba(69, 73, 74, 0.16);
  }
  .story__print img {
    width: 100%;
    height: 500px;
    object-fit: cover;
    object-position: center 30%;
  }
  .story__print figcaption {
    font-style: italic;
    font-size: 15px;
    text-align: center;
    color: var(--ink-soft);
  }
  .story__copy {
    display: flex;
    flex-direction: column;
    gap: 24px;
    max-width: 560px;
  }
  .story__headline { font-size: clamp(32px, 3.2vw, 44px); line-height: 1.23; }
  .story__lede {
    font-style: italic;
    font-size: 21px;
    line-height: 32px;
  }
  .story__body {
    font-size: 17px;
    line-height: 27px;
    color: var(--ink-soft);
  }
  .story__body--strong { color: var(--ink); }

  @media (max-width: 1000px) {
    .story { flex-direction: column; gap: 70px; }
    .story__photo-wrap { width: min(470px, 88%); }
  }
</style>
