---
import Button from "./Button.astro";

const principles = [
  { n: "01", text: "Create a natural flow between indoors and out" },
  { n: "02", text: "Design one continuous experience or several distinct moments" },
  { n: "03", text: "Work with a considered group of event partners" },
  { n: "04", text: "Use what the venue gives you—or take it somewhere new" },
];
---

<section class="cf" id="events">
  <div class="cf__header">
    <span class="eyebrow">Creative Freedom</span>
    <h2 class="cf__headline">Not a package. <em>A point of departure.</em></h2>
    <p class="cf__lede">
      There is no single way Blanc is supposed to look. We’ll provide the framework, practical
      support, and a place with enough character to inspire you without taking over.
    </p>
  </div>

  <div class="cf__stack" data-reveal-items=".cf__item">
    {principles.map((p) => (
      <div class="cf__item">
        <span class="cf__number">{p.n}</span>
        <span class="cf__text">{p.text}</span>
      </div>
    ))}
  </div>

  <Button href="#visit" variant="solid">Tell Us What You’re Imagining</Button>
</section>

<style>
  .cf {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 70px;
    padding: 130px 9.7%;
    background: var(--paper);
  }
  .cf__header {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    text-align: center;
  }
  .cf__headline {
    font-size: clamp(30px, 3.2vw, 44px);
    line-height: 1.23;
  }
  .cf__headline em { font-style: italic; }
  .cf__lede {
    max-width: 620px;
    font-size: 17px;
    line-height: 27px;
    color: var(--ink-soft);
  }
  .cf__stack {
    display: flex;
    flex-direction: column;
    width: min(1160px, 100%);
  }
  .cf__item {
    display: flex;
    align-items: center;
    gap: 72px;
    padding: 34px 0;
  }
  .cf__item + .cf__item { border-top: 1px solid var(--ink-hairline); }
  .cf__item:nth-child(even) {
    flex-direction: row-reverse;
    text-align: right;
  }
  .cf__number {
    flex-shrink: 0;
    font-size: clamp(200px, 21vw, 300px);
    line-height: 0.78;
    font-style: italic;
    color: var(--iron);
  }
  .cf__text {
    max-width: 400px;
    font-size: 22px;
    line-height: 34px;
  }
  .cf__item:nth-child(odd) .cf__text { margin-left: auto; }
  .cf__item:nth-child(even) .cf__text { margin-right: auto; }

  @media (max-width: 700px) {
    .cf__item,
    .cf__item:nth-child(even) {
      flex-direction: column;
      align-items: flex-start;
      gap: 20px;
      text-align: left;
      padding: 44px 0;
    }
    .cf__item:nth-child(odd) .cf__text { margin-left: 0; }
    .cf__item:nth-child(even) .cf__text { margin-right: 0; }
  }
</style>
