---
import WordmarkPaths from "./WordmarkPaths.astro";
import Button from "./Button.astro";
import { withBase } from "../lib/paths";
---

<header class="hero">
  <img class="hero__photo" src={withBase("/images/b4.jpg")} alt="The Blanc courtyard set for a wedding reception under string lights" />
  <div class="hero__scrim"></div>

  <div class="hero__center">
    <span class="hero__eyebrow">Denver / RiNo</span>
    <svg class="hero__wordmark" viewBox="0 0 738.12 245.98" role="img" aria-label="Blanc">
      <WordmarkPaths />
    </svg>
    <p class="hero__sub">
      A hidden indoor-outdoor venue in the heart of RiNo—full of character, open to
      interpretation, and ready for a celebration that feels unmistakably yours.
    </p>
    <div class="hero__ctas">
      <Button href="#visit" variant="solid-paper">Plan a Visit</Button>
      <Button href="#spaces" variant="outline-paper">See the Spaces</Button>
    </div>
  </div>

  <div class="hero__bottom">
    <span>Now booking 2027 dates</span>
    <span>3150 Walnut St, Denver, CO 80205</span>
  </div>
</header>

<style>
  .hero {
    position: relative;
    height: 100vh;
    min-height: 640px;
    overflow: hidden;
    background: var(--ink);
  }
  .hero__photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero__scrim {
    position: absolute;
    inset: 0;
    background: var(--scrim);
  }
  .hero__center {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 28px;
    padding-top: 40px;
    text-align: center;
    color: var(--paper);
  }
  .hero__eyebrow {
    font-size: 13px;
    letter-spacing: var(--tracking-caps);
  }
  .hero__wordmark {
    width: min(540px, 78vw);
    height: auto;
    color: var(--paper);
  }
  .hero__sub {
    max-width: 640px;
    padding: 0 24px;
    font-size: 18px;
    line-height: 28px;
  }
  .hero__ctas {
    display: flex;
    gap: 16px;
    margin-top: 8px;
  }
  .hero__bottom {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    display: flex;
    justify-content: space-between;
    padding: 28px 48px;
    font-size: 13px;
    letter-spacing: 0.06em;
    color: var(--paper-soft);
  }

  @media (max-width: 700px) {
    .hero__bottom { padding: 20px 24px; font-size: 11px; }
    .hero__sub { font-size: 16px; line-height: 25px; }
  }
</style>
